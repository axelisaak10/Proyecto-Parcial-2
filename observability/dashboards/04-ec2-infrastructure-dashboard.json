          "id": "inf_cpu",
          "type": "line",
          "title": "CPU (%)",
          "description": "",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "decimals": 2,
            "unit": "percent"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS ts, AVG(cpu_percent) AS cpu_percent FROM \"ec2_infrastructure\" GROUP BY ts ORDER BY ts",
              "customQuery": true,
              "fields": {
                "stream": "ec2_infrastructure",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Tiempo",
                    "alias": "ts",
                    "column": "ts",
                    "color": null,
                    "isDerived": false
                  }
                ],
                "y": [
                  {
                    "label": "CPU %",
                    "alias": "cpu_percent",
                    "column": "cpu_percent",
                    "color": "#ea580c",
                    "isDerived": false
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "limit": 0,
                "min": 0,
