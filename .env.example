# Docker Hub Registry
DOCKERHUB_USERNAME=your_dockerhub_username

# Backend Security & JWT (minimum 32 random characters in production)
JWT_KEY=replace_with_a_strong_random_64_char_secret_key

# AWS EC2 Public IP or Domain
EC2_HOST=xx.xxx.xxx.xx

# OpenObserve Self-Hosted Credentials
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=admin@toystore.com
OPENOBSERVE_PASSWORD=ChangeMeStrongPassword2026!
